{
  "name": "ohlr-duat-planning-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OHLR-DUAT Planning Tool vertical slice",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node scripts/run-with-electron-node.mjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-with-electron-node.mjs ./node_modules/vitest/vitest.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.69.0",
    "@fluentui/react-icons": "^2.0.315",
    "better-sqlite3": "12.11.1",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
